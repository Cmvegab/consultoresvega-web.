# ═══════════════════════════════════════════════════════════
# Consultores Vega — Apache Configuration
# ═══════════════════════════════════════════════════════════

# ── Compresión GZIP + Brotli ────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2

  # Forzar compresión ignorando cabeceras defectuosas de proxies
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff font/woff2
</IfModule>

# ── Fallback: mod_filter (alternativa si mod_deflate no está disponible) ──
<IfModule mod_filter.c>
  FilterDeclare COMPRESS
  FilterProvider COMPRESS DEFLATE "%{Content_Type} = 'text/html'"
  FilterProvider COMPRESS DEFLATE "%{Content_Type} = 'text/css'"
  FilterProvider COMPRESS DEFLATE "%{Content_Type} = 'application/javascript'"
  FilterChain COMPRESS
  FilterProtocol COMPRESS DEFLATE change=yes;byteranges=no
</IfModule>

# ── Cache Control ────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes WebP / PNG / JPG — 1 año
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/gif              "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"

  # CSS y JS — 1 año (usar ?v=X en HTML para cache-busting)
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript        "access plus 1 year"

  # HTML — sin caché (siempre fresco)
  ExpiresByType text/html              "access plus 0 seconds"

  # Fuentes — 1 año
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # XML / JSON — 1 día
  ExpiresByType application/xml        "access plus 1 day"
  ExpiresByType text/xml               "access plus 1 day"
  ExpiresByType application/json       "access plus 1 day"
</IfModule>

# ── Cache-Control headers explícitos ─────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# ── MIME types para fuentes y WebP ────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
  AddType image/webp .webp
</IfModule>

# ── HTTPS redirect ────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www redirect
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html → / (evita contenido duplicado)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # /servicios/ no tiene índice propio → sección de servicios del home
  RewriteRule ^servicios/?$ /#servicios [L,R=301,NE]
</IfModule>

# ── Seguridad básica ──────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# ── Página 404 personalizada ──────────────────────────────────
ErrorDocument 404 /404.html
